# Trim the build context.
#
# The vendored Emacs package tree (entrypoint/dotfiles/.emacs.d/elpa) stays in git
# but is NOT baked into the image: `make shell` bind-mounts it at
# /root/.emacs.d/elpa (ELPA_MOUNT in the Makefile) and `make update-emacs-packages`
# refreshes it. Only elpa/ is excluded -- the rest of entrypoint/dotfiles (init.el,
# helm.el, preferences.el, .extrabashrc, .tmux.conf) is still copied to /root.
entrypoint/dotfiles/.emacs.d/elpa

# VCS metadata, Python caches and build metadata -- `COPY src /mvm/src` must bake
# only clean source.
.git
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Built book/proof output (regenerated into /output) and image-export tarballs.
output/
proofs/*.aux
proofs/*.log
proofs/*.pdf
*.tar
